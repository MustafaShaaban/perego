{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "perego-theme/portfolio-grid",
	"title": "Perego Portfolio Grid",
	"category": "theme",
	"icon": "grid-view",
	"description": "The work/portfolio grid: a service-filter chip row and a masonry grid of project cards queried from the project CPT, with a no-results state. Server-rendered; the client-side filter is wired via view.js.",
	"textdomain": "perego-site",
	"attributes": {
		"headingEn": { "type": "string", "default": "" },
		"headingAr": { "type": "string", "default": "" },
		"introEn": { "type": "string", "default": "" },
		"introAr": { "type": "string", "default": "" },
		"ctaTitleEn": { "type": "string", "default": "" },
		"ctaTitleAr": { "type": "string", "default": "" },
		"ctaBodyEn": { "type": "string", "default": "" },
		"ctaBodyAr": { "type": "string", "default": "" },
		"ctaButtonEn": { "type": "string", "default": "" },
		"ctaButtonAr": { "type": "string", "default": "" },
		"showDemoNote": { "type": "boolean", "default": true },
		"showBreadcrumb": { "type": "boolean", "default": true },
		"featuredOnly": { "type": "boolean", "default": false },
		"projectOrder": { "type": "array", "default": [], "items": { "type": "number" } },
		"ctaUrl": { "type": "string", "default": "" },
		"ctaLinkKind": { "type": "string", "default": "custom" },
		"ctaPostType": { "type": "string", "default": "" },
		"ctaPostId": { "type": "number", "default": 0 },
		"ctaOpenInNewTab": { "type": "boolean", "default": false }
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-index.css",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	}
}
