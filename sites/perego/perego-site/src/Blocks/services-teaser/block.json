{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "perego-theme/services-teaser",
	"title": "Perego Services Teaser",
	"category": "theme",
	"icon": "grid-view",
	"description": "The homepage services teaser: a heading, a See All Services link, and the four service cards (staggered offsets + hover lift). Server-rendered; hover is pure CSS (no view script).",
	"textdomain": "perego-site",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"attributes": {
		"headingEn": { "type": "string", "default": "" },
		"seeAllEn": { "type": "string", "default": "" },
		"headingAr": { "type": "string", "default": "" },
		"seeAllAr": { "type": "string", "default": "" },
		"servicesMode": { "type": "string", "default": "automatic" },
		"serviceOrder": { "type": "array", "default": [] },
		"serviceExcludeIds": { "type": "array", "default": [] },
		"seeAllUrl": { "type": "string", "default": "" },
		"seeAllLinkKind": { "type": "string", "default": "custom" },
		"seeAllPostType": { "type": "string", "default": "" },
		"seeAllPostId": { "type": "number", "default": 0 },
		"seeAllOpenInNewTab": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false
	}
}
