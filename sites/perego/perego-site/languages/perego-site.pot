msgid "Perego Clients Carousel"
msgstr ""

#: src/Blocks/clients-carousel/block.json
msgctxt "block description"
msgid "The homepage Corporate + Individual client carousels. Cards are server-rendered (work without JS); Swiper (modular: Navigation, Pagination, Keyboard, A11y) enhances them. Language-aware."
msgstr ""

#: src/Blocks/global-section/block.json
msgctxt "block title"
msgid "Perego Global Section"
msgstr ""

#: src/Blocks/global-section/block.json
msgctxt "block description"
msgid "Renders a language-aware perego_global_section record (header, footer, CTA, contact details, 404) resolved by role for the current Polylang language."
msgstr ""

#: src/Blocks/hero-slider/block.json
msgctxt "block title"
msgid "Perego Hero Slider"
msgstr ""

#: src/Blocks/hero-slider/block.json
msgctxt "block description"
msgid "The homepage hero: a rotating set of headline slides with dot tabs, prev/next and pause/play controls, an aria-live announcer, and a CTA. Auto-advances (6.5s), pauses on hover and when the tab is hidden, and never auto-advances under reduced motion. Server-rendered; interactivity via view.js."
msgstr ""

#: src/Blocks/home-about-bg/block.json
msgctxt "block title"
msgid "Perego Home About Background"
msgstr ""

#: src/Blocks/home-about-bg/block.json
msgctxt "block description"
msgid "The homepage About section's full-bleed background image, absolutely positioned behind the editor-canvas panel content. Server-rendered; no view script."
msgstr ""

