#: src/Blocks/hero-slider/block.json
msgctxt "block title"
msgid "Perego Hero Slider"
msgstr ""

#: src/Blocks/hero-slider/block.json
msgctxt "block description"
msgid "The homepage hero: a rotating set of headline slides with dot tabs, prev/next and pause/play controls, an aria-live announcer, and a CTA. Auto-advances (6.5s), pauses on hover and when the tab is hidden, and never auto-advances under reduced motion. Server-rendered; interactivity via view.js."
msgstr ""

