# Perego client static assets use stable filenames, so keep a finite cache lifetime rather than
# `immutable`. Production hosts/CDNs that do not read Apache directory rules should mirror this
# 30-day policy and purge changed paths during deployment.
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/avif "access plus 30 days"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType font/woff2 "access plus 30 days"
	ExpiresByType text/css "access plus 30 days"
	ExpiresByType application/javascript "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(?:avif|css|gif|jpe?g|js|png|svg|webp|woff2)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>
